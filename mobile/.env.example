# Base URL of the AsyncForge Next.js API.
#
# Leave this UNSET for local development. The app falls back to Metro's own
# host (Constants.expoConfig.hostUri), which is by definition the machine
# running the bundler — and therefore the machine running `pnpm dev`. That
# works for simulators, emulators and physical devices without configuration,
# and survives your LAN address changing.
#
# Set it only to target a real deployment. Values are inlined into the bundle
# at build time, so never put secrets here.
#
# EXPO_PUBLIC_API_URL=https://asyncforge.example.com
